# ── TriNetra CSI node — build defaults ──────────────────────────────────
# Applied by `idf.py build`. Values here matter for CSI quality; the ones
# marked CRITICAL will silently ruin your sensing data if changed.

# CRITICAL: CSI capture must be compiled in.
CONFIG_ESP_WIFI_CSI_ENABLED=y

# CRITICAL: power save off. Modem sleep parks the radio between beacons,
# collapsing the CSI rate to ~10 Hz with heavy jitter — far too slow and
# irregular for the 0.8-2.0 Hz heart-rate band.
CONFIG_ESP_WIFI_PS_NONE=y

# More RX buffers: CSI callbacks arrive in the WiFi task, and starving the
# driver of buffers shows up as dropped frames under load.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=16

# Main task stack — the sensing task allocates large static float buffers.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Run at full clock. DSP over a 256-sample window at 20 Hz is comfortable
# at 240 MHz and marginal at 80.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# Float support in log formatting (we print BPM values).
CONFIG_NEWLIB_NANO_FORMAT=n

# Serial console for provision.py.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Partition table with OTA slots.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Compiler
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Watchdog: the sensing task can block for up to 200 ms on the CSI queue.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# LWIP: small UDP send buffers are fine, we never queue deeply.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096


# Sensing server address. Must be the machine running `npm run live`, on the
# subnet the node joins. Wrong value = silent failure: UDP is unacknowledged,
# so the node reports "online" and streams into the void.
CONFIG_TN_DEFAULT_TARGET_IP="192.168.1.20"
